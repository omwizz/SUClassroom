NEXT_PUBLIC_APP_URL=

# Project URL exacto de Supabase. Debe verse como:
# https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publica anon/publishable de Supabase.
# No pongas aqui claves sb_secret_ ni service role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Nunca la uses con NEXT_PUBLIC_ ni en componentes client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket privado de Supabase Storage para evidencia de entregables.
SUPABASE_DELIVERABLES_BUCKET=deliverables

# Solo servidor. Usa el Transaction Pooler de Supabase o un usuario dedicado
# con permisos sobre el esquema public. No la expongas como NEXT_PUBLIC_.
DATABASE_URL=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
